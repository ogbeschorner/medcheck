# Local PostgreSQL settings only. These defaults are intentionally non-secret.
# Copy to .env and replace DJANGO_SECRET_KEY; never commit a real .env file.
POSTGRES_DB=medcheck
POSTGRES_USER=medcheck
POSTGRES_PASSWORD=local-development-only-placeholder
POSTGRES_PORT=127.0.0.1:5432
POSTGRES_HOST=127.0.0.1
POSTGRES_DB_PORT=5432
DJANGO_SECRET_KEY=replace-with-a-unique-local-development-key
DJANGO_DEBUG=true
